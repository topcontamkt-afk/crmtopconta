{
  "name": "crmtopconta-cf-spike",
  "private": true,
  "description": "Fase 0 da migração para a Cloudflare: prova local de Express + Prisma 7 + D1 (descartável).",
  "scripts": {
    "generate": "prisma generate",
    "migration": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script > prisma/migrations/0001_init.sql",
    "db:local": "wrangler d1 execute crmtopconta-spike --local --file=prisma/migrations/0001_init.sql",
    "dev": "wrangler dev",
    "bundle": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@prisma/adapter-d1": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261003.1",
    "@types/express": "^4.17.21",
    "prisma": "7.10.0",
    "wrangler": "4.147.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.1": true,
    "prisma@7.10.0": true,
    "workerd@1.20261001.1": true
  },
  "overrides": {
    "iconv-lite": "0.7.3"
  }
}

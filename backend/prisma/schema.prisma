// CRM TopConta — Prisma schema
// Modela as entidades principais descritas no PRD:
// Tenant, User, Client, ImportJob, Movement, SegmentDefinition,
// Campaign, MessageEvent, AutomationRule, AuditLog

generator client {
  // Prisma 7 sem engine Rust: o compilador de queries é WASM e o banco chega por adapter
  // (D1 no Worker, better-sqlite3 nos testes; ver src/config/db.ts).
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "cloudflare"
  moduleFormat = "cjs"
}

datasource db {
  // Cloudflare D1 (SQLite). A URL só existe no prisma.config.ts, para o `migrate diff`.
  provider = "sqlite"
}

enum Role {
  ADMIN
  OPERATOR
  ANALYST
  VIEWER
}

enum ClientStatus {
  ATIVO
  INATIVO
  BLOQUEADO
}

enum UsageFaixa {
  SEM_USO // 0%
  USO_1_10
  USO_11_20
  USO_21_30
  USO_31_50
  USO_51_70
  USO_71_99
  USO_100
  INDEFINIDO // limite_total inválido/zero
}

enum Channel {
  WHATSAPP
  SMS
}

enum CampaignStatus {
  RASCUNHO
  AGENDADA
  EM_EXECUCAO
  PAUSADA
  CONCLUIDA
  CANCELADA
}

enum MessageStatus {
  FILA
  ENVIADO
  ENTREGUE
  LIDO
  RESPONDIDO
  FALHA
  BLOQUEADO
  CONTROLE // grupo de controle: fazia parte do público, mas NÃO recebeu a mensagem (mede o lift real)
}

enum ImportStatus {
  PENDENTE
  EM_EXECUCAO
  CONCLUIDO
  CONCLUIDO_COM_ERROS
  FALHOU
}

enum TemplateStatus {
  RASCUNHO
  PENDENTE_APROVACAO
  APROVADO
  REJEITADO
}

enum NotificationSeverity {
  INFO
  AVISO
  ERRO
}

model Tenant {
  id                String   @id @default(uuid())
  name              String
  cpfSalt           String   @default(uuid()) // salt por tenant para hash de CPF
  retentionDays     Int      @default(1095) // 3 anos default (LGPD)
  maxMsgsPerMinute  Int      @default(600) // rate limit global do tenant, aplicado no dispatch de campanhas
  // Custo estimado por mensagem do WhatsApp (tabela da Meta, em dólar, por categoria) e o câmbio usado
  // para mostrar em reais no assistente de campanhas. Nulo = usa o padrão de services/messageCost.ts.
  custoMarketingUsd Decimal?
  custoUtilidadeUsd Decimal?
  cambioUsdBrl      Decimal?
  // Qual conexão de WhatsApp o sistema usa para ENVIAR (campanhas): META (oficial, com template) ou ZAPI
  // (não oficial, texto livre). Receber vale para as duas conectadas. Configurações → WhatsApp.
  whatsappProvider  String   @default("META")

  // LGPD: configuração do CONTROLADOR (cada tenant é um controlador distinto). Ver docs/lgpd/.
  // Base legal declarada para mensagens de marketing: LEGITIMO_INTERESSE | CONSENTIMENTO. Nulo = o controlador
  // ainda não declarou, e o envio de marketing fica bloqueado (02-01).
  baseLegalMarketing        String?
  liaVersao                 String? // versão do teste de balanceamento (LIA) quando a base é legítimo interesse
  liaAprovadaEm             DateTime?
  controladorNome           String? // nome que identifica o controlador nas mensagens; nulo = `name` (02-05)
  encarregadoNome           String? // encarregado (DPO) ou responsável pelo canal do titular (03-06)
  encarregadoContato        String? // e-mail, telefone ou link do canal do titular
  avisoPrivacidadeUrl       String?
  rodapeOptOut              String? // rodapé de descadastro das mensagens; nulo = padrão do sistema
  retentionBasis            String? // fundamento do prazo de retenção (04-07)
  retentionDaysAfterClosure Int? // prazo após o encerramento da conta; nulo = retentionDays (04-06)
  inboxRetentionDays        Int? // prazo de conversas da Inbox; nulo = retentionDays (04-02)
  mediaRetentionDays        Int      @default(90) // prazo das cópias de mídia do WhatsApp (04-02)
  correcaoManualVence       Boolean  @default(true) // correção feita no CRM não é sobrescrita pela planilha (03-03)

  createdAt         DateTime @default(now())

  users              User[]
  clients            Client[]
  importJobs         ImportJob[]
  segments           SegmentDefinition[]
  campaigns          Campaign[]
  campaignRecipients CampaignRecipient[]
  automationRules    AutomationRule[]
  auditLogs          AuditLog[]
  sheetConnections   SheetConnection[]
  channelConfigs     ChannelConfig[]
  messageTemplates   MessageTemplate[]
  notifications      Notification[]
  accountSnapshots   AccountSnapshot[]
  dashboardSnapshots DashboardSnapshot[]
  merchants          Merchant[]
  purchases          Purchase[]
  whatsAppAccounts   WhatsAppAccount[]
  conversations      Conversation[]
  waMessages         WaMessage[]
  waMediaBlobs       WaMediaBlob[]
  templateMedias     TemplateMedia[]
  importChanges      ImportChange[]
  ciclosCidade       CicloCidade[]
  supressoes         SupressaoTitular[]
  pedidosTitular     PedidoTitular[]
  clientTags         ClientTag[]
  movements          Movement[]
  messageEvents      MessageEvent[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(VIEWER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Acesso por área do sistema (services/areas.ts). `areasRestritas=false` = vê todas as áreas (padrão e
  // quem já existia); true = só as de `areas`. ADMIN sempre vê tudo. O papel (role) continua dizendo o que
  // a pessoa pode FAZER dentro da área; isto diz ONDE ela pode entrar.
  areasRestritas Boolean  @default(false)
  areas          Json     @default("[]") // string[] de services/areas.ts

  // Segurança de login (rate limiting anti brute-force) — armazenado no banco (não em memória
  // do processo) para funcionar de forma consistente entre invocações serverless distintas.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime? // conta bloqueada para login até este instante

  // Forçado após reset de senha por um Admin (sem fluxo de e-mail) — o próprio usuário troca no
  // primeiro login seguinte.
  mustChangePassword Boolean @default(false)

  // 2FA (TOTP, tipo Google Authenticator) — segredo cifrado em repouso (envelope encryption,
  // mesma abordagem de ChannelConfig.credentials, ver services/crypto.ts). O segredo só é
  // considerado válido para login quando twoFactorEnabled = true (setup não confirmado ainda
  // não afeta o login).
  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)

  auditLogs AuditLog[]
}

model Client {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  externalId    String? // id_cliente da planilha de origem
  nome          String
  telefone      String // normalizado E.164
  email         String?
  // cpfHash/cpfMasked guardam CPF (pessoa física) OU CNPJ (pessoa jurídica) — a coluna de
  // origem real ("CpfCnpjCliente") traz os dois; documentoTipo diferencia qual é qual.
  // Ver services/masking.ts (isValidDocument/hashDocument/maskDocument).
  cpfHash       String
  cpfMasked     String
  documentoTipo String? // "CPF" | "CNPJ"
  cidade        String?

  dataCadastro         DateTime?
  dataAberturaConta    DateTime?
  limiteTotal          Decimal   @default(0)
  valorUtilizado       Decimal   @default(0)
  saldoDisponivel      Decimal   @default(0)
  valorAntecipado      Decimal   @default(0)
  dataUltimaUtilizacao DateTime?
  // Uso REAL pelo extrato (antecipação/compra), refeito por services/usageRefresh.ts
  ultimoUsoReal        DateTime?
  usosUltimos90d       Int       @default(0)
  usosTotal            Int       @default(0)
  diaCicloAbertura     Int? // dia do mês em que o limite renova (da cidade; ver services/ciclos.ts)

  percentualUtilizado Decimal    @default(0)
  faixaUso            UsageFaixa @default(SEM_USO)

  statusConta            ClientStatus @default(ATIVO)
  origemCliente          String?
  autorizacaoComunicacao Boolean      @default(false)
  optOutAt               DateTime?

  // Cartão/conta vinculado a convênio (folha de pagamento): nome e cidade da empresa
  // conveniada, e vínculo empregatício do titular — usados para segmentar campanhas por
  // convênio (ex.: "só servidores efetivos da Prefeitura de Lagarto"). Preenchidos apenas
  // pelo formato de importação que os traz (nem toda planilha real tem essas colunas).
  empresaConveniada       String?
  cidadeEmpresaConveniada String?
  vinculoEmpregaticio     String?
  statusValidacaoCadastro String? // eixo de validação de cadastro, separado do statusConta (ex.: "APROVADO")

  // Encerramento de conta — distinto de statusConta=BLOQUEADO (que é uma trava ativa); conta
  // encerrada é tratada como INATIVA na importação, mas mantém o motivo para consulta.
  encerradoEm        DateTime?
  motivoEncerramento String?
  obsEncerramento    String?

  // Campos da aba "SaldoCartao" (fonte real mais completa, confirmada com o cliente) — nem
  // toda planilha real traz isso, por isso tudo opcional.
  razaoSocial        String? // razão social da promotora/associação que administra o cartão
  lotacao            String? // departamento/unidade de trabalho do titular (servidor público)
  dataValidadeCartao DateTime?
  dataNascimento     DateTime?
  sexo               String?
  remuneracaoBruta   Decimal?
  remuneracaoLiquida Decimal?
  bonus              Decimal?
  saldoLiquidoSaque  Decimal?

  tags      ClientTag[]
  purchases Purchase[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastImportJobId String?
  anonymizedAt    DateTime? // preenchido pelo job de retenção/right-to-be-forgotten (LGPD)
  // LGPD 03-04: tratamento suspenso a pedido do titular (fora de campanha, segmento, export e automação).
  bloqueadoLgpdAt DateTime?
  // LGPD 03-03: campos corrigidos à mão a pedido do titular ({ campo: ISODate }); a importação não os sobrescreve
  // quando Tenant.correcaoManualVence.
  camposCorrigidos Json?

  movements          Movement[]
  messageEvents      MessageEvent[]
  campaignRecipients CampaignRecipient[]
  accountSnapshots   AccountSnapshot[]
  conversations      Conversation[]

  @@unique([tenantId, cpfHash])
  @@index([tenantId, telefone])
  @@index([tenantId, cidade])
  @@index([tenantId, diaCicloAbertura])
  @@index([tenantId, faixaUso])
  @@index([tenantId, ultimoUsoReal])
  @@index([tenantId, statusConta])
}

model ImportJob {
  id           String       @id @default(uuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  source       String       @default("google_sheets") // google_sheets | csv
  sheetId      String?
  status       ImportStatus @default(PENDENTE)
  totalRows    Int          @default(0)
  addedCount   Int          @default(0)
  updatedCount Int          @default(0)
  errorCount   Int          @default(0)
  errors       Json? // lista de {row, motivo}
  startedAt    DateTime     @default(now())
  finishedAt   DateTime?
  triggeredBy  String? // userId ou "scheduler"
  // Proteção da importação: formato usado (cartoes | generico | compras | google_sheets), lote (todas as
  // requisições de UM arquivo compartilham o loteId) e nome do arquivo; `desfeitaEm` marca lote desfeito.
  formato      String?
  loteId       String?
  nomeArquivo  String?
  desfeitaEm   DateTime?
  desfeitaPor  String?

  changes ImportChange[]

  @@index([tenantId, loteId])
}

/// Estado ANTERIOR dos clientes que uma importação alterou/criou: é o que permite desfazer o lote
/// (services/importUndo.ts). `before` guarda só as colunas que a importação gravou. Expira em 30 dias.
model ImportChange {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  importJobId String
  importJob   ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  loteId      String?
  clientId    String
  kind        String // ATUALIZADO | CRIADO
  before      Json?
  createdAt   DateTime  @default(now())

  @@index([tenantId, loteId])
  @@index([importJobId])
}

model Movement {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  tipo      String // ex: utilizacao, pagamento, antecipacao
  valor     Decimal
  data      DateTime
  createdAt DateTime @default(now())

  @@index([clientId, data])
  @@index([tenantId])
}

// Histórico de saldo/limite/status da conta. Client guarda só o estado atual (sobrescrito a cada
// importação), e o saldo oscila com o ciclo da folha (usa -> fatura descontada -> limite renova);
// sem histórico não dá para saber QUANDO o limite voltou nem quem tinha saldo na data de um
// disparo. Gravado por services/accountSnapshot.ts durante a importação de "Cartões e contas".
//
// É um registro de MUDANÇAS, não uma foto diária de toda a base: só entra linha quando saldo,
// limite ou status mudam (ou na primeira vez que o cliente é visto) — a base inteira todo dia
// seriam milhões de linhas por ano para guardar "nada mudou". Estado numa data D = a última
// linha com recordedAt <= D. saldoAnterior (nulo na 1ª linha) dá o delta sem precisar de join.
model AccountSnapshot {
  id              String       @id @default(uuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  clientId        String
  client          Client       @relation(fields: [clientId], references: [id])
  recordedAt      DateTime     @default(now())
  limiteTotal     Decimal
  saldoDisponivel Decimal
  saldoAnterior   Decimal?
  valorUtilizado  Decimal
  statusConta     ClientStatus
  importJobId     String?

  @@index([tenantId, clientId, recordedAt])
  @@index([tenantId, recordedAt])
}

model SegmentDefinition {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  name            String
  // Estrutura de grupos combináveis (AND/OR): { operator: 'AND'|'OR', conditions: SegmentFilters,
  // groups?: SegmentGroup[] } — ver src/services/segments.ts. Mantido em Json para não exigir
  // migração a cada novo campo de filtro suportado.
  filters         Json
  operator        String    @default("AND") // AND | OR entre grupos de filtro (legado/top-level)
  lastCount       Int?
  dynamic         Boolean   @default(true) // segmento dinâmico: recontagem periódica via scheduler
  refreshCron     String    @default("0 * * * *") // a cada hora, por padrão
  lastRefreshedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  campaigns Campaign[]
}

model Campaign {
  id           String             @id @default(uuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  name         String
  objective    String?
  channel      Channel
  segmentId    String?
  segment      SegmentDefinition? @relation(fields: [segmentId], references: [id])
  adHocFilters Json? // filtros aplicados diretamente no wizard, se não usar segmento salvo

  templateId      String?
  template        MessageTemplate? @relation(fields: [templateId], references: [id])
  messageTemplate String // corpo com placeholders {{nome}}, {{cidade}}, {{percentual}}... (variante A, ou texto livre se sem templateId)
  status          CampaignStatus   @default(RASCUNHO)

  // A/B testing básico: quando variantSplitPercent está definido, uma fração do público
  // recebe messageTemplateB no lugar de messageTemplate (variante A).
  messageTemplateB    String?
  variantSplitPercent Int? // 0-100, % do público que recebe a variante B

  manual    Boolean @default(false) // lista de planilha (CampaignRecipient) em vez de segmento
  isSandbox Boolean @default(false) // campanhas de teste/QA não contam para relatórios agregados

  // LGPD 02-01: base legal vigente no tenant no momento em que a campanha foi criada.
  baseLegal           String?
  // LGPD 02-01/02-02: lista manual com contatos fora da base exige origem do consentimento declarada (quem, quando).
  consentimentoOrigem String?
  consentimentoPor    String?
  consentimentoEm     DateTime?

  scheduledAt         DateTime?
  throttlePerMin      Int       @default(60)
  dedupeWindowHrs     Int       @default(72) // janela mínima entre envios da mesma msg ao mesmo cliente
  attributionDays     Int       @default(7)
  // Grupo de controle (opcional): % do público reservado que NÃO recebe a mensagem, só para
  // comparar o uso de quem recebeu com o de quem não recebeu. Nulo/0 = desligado.
  controlGroupPercent Int?
  costPerMessage      Decimal   @default(0)

  audienceCount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messageEvents MessageEvent[]
  recipients    CampaignRecipient[]
}

model MessageEvent {
  id             String             @id @default(uuid())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  campaignId     String
  campaign       Campaign           @relation(fields: [campaignId], references: [id])
  // Nulo só em campanha manual (lista de planilha) com contato que ainda não está na base;
  // o vínculo é refeito depois (services/manualCampaign.ts linkRecipients).
  clientId       String?
  client         Client?            @relation(fields: [clientId], references: [id])
  recipientId    String?
  recipient      CampaignRecipient? @relation(fields: [recipientId], references: [id])
  channel        Channel
  status         MessageStatus      @default(FILA)
  variant        String             @default("A") // "A" ou "B" — usado quando a campanha tem A/B testing ativo
  provider       String? // provedor efetivamente usado (para failover multi-provider de SMS)
  providerMsgId  String?
  cost           Decimal            @default(0)
  error          String?
  queuedAt       DateTime           @default(now())
  sentAt         DateTime?
  deliveredAt    DateTime?
  respondedAt    DateTime?
  convertedAt    DateTime? // primeira movimentação dentro da janela de atribuição
  convertedValue Decimal? // valor da movimentação que gerou a conversão (ROI)
  clickedAt      DateTime? // 1º clique no botão de link rastreado (services/trackedLinks.ts, rota /r/:token)
  clickCount     Int                @default(0)

  @@index([campaignId, status])
  @@index([clientId])
  @@index([recipientId])
  @@index([tenantId, status])
}

/// Destinatário de uma campanha manual (lista de planilha). Fica guardado depois do envio para
/// analisar a campanha. CPF só como hash (mesmo HMAC por tenant da base); `clientId` é preenchido
/// quando o contato existe (ou passa a existir) na base.
model CampaignRecipient {
  id               String    @id @default(uuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  campaignId       String
  campaign         Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  nome             String
  telefone         String // E.164
  cpfHash          String?
  cpfMasked        String?
  limiteDisponivel Decimal? // valor da planilha; só aparece na mensagem, não altera o cliente
  clientId         String?
  client           Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  optOutAt         DateTime? // pediu para parar (contato fora da base); vale para as próximas listas
  createdAt        DateTime  @default(now())

  messageEvents MessageEvent[]

  @@unique([campaignId, telefone])
  @@index([tenantId, cpfHash])
  @@index([tenantId, telefone])
  @@index([clientId])
}

model AutomationRule {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  name      String
  trigger   String // NOVO_CLIENTE_SEM_USO | INATIVO_30_DIAS | LIMITE_RENOVADO | ESTIMULO_FAIXA | OPT_OUT_TELEFONE_INVALIDO | ETAPA_PERFIL | CICLO_ABERTO
  condition Json?
  action    Json // { type: 'campaign' | 'notification' | 'block', ... }
  enabled   Boolean   @default(false)
  lastRunAt DateTime? // usado para não reavaliar o mesmo evento repetidamente (janela desde a última execução)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  target    String?
  targetId  String?
  details   Json?
  createdAt DateTime @default(now())
  // Hash-chain (tamper-evidence, achado #11 do docs/security-audit/findings.md): prevHash é o
  // `hash` da entrada anterior DO MESMO TENANT (LGPD 08-08: cada controlador verifica a própria
  // cadeia; as linhas antigas, encadeadas globalmente, terminam numa âncora AUDIT_CADEIA_POR_TENANT);
  // hash é o SHA-256 desta própria linha + prevHash. Ambos nullable porque entradas gravadas antes
  // da cadeia não entram retroativamente nela (limitação aceita, ver services/auditIntegrity.ts).
  prevHash  String?
  hash      String?

  @@index([tenantId, createdAt])
}

model SheetConnection {
  id            String    @id @default(uuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  sheetId       String
  sheetRange    String    @default("A1:Z")
  authType      String    @default("service_account") // service_account | oauth2
  columnMapping Json // { "id_cliente": "A", "nome": "B", ... }
  cronSchedule  String    @default("0 6 * * 1,4") // 2x/semana por padrão
  lastSyncAt    DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

model ChannelConfig {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  channel       Channel
  provider      String // whatsapp_cloud_api | twilio | zenvia ...
  // Envelope encryption: { iv, authTag, ciphertext } em base64, cifrado com AES-256-GCM usando
  // a chave mestra da aplicação (env CREDENTIALS_ENCRYPTION_KEY — simula uma KMS externa).
  // Nunca contém as credenciais em texto plano. Ver src/services/crypto.ts.
  credentials   Json
  // Ordem de fallback entre múltiplos provedores do mesmo canal (menor = tentado primeiro).
  // Usado principalmente para failover multi-provider de SMS.
  priority      Int      @default(0)
  webhookSecret String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@unique([tenantId, channel, provider])
  @@index([tenantId, channel, priority])
}

model MessageTemplate {
  id                 String         @id @default(uuid())
  tenantId           String
  tenant             Tenant         @relation(fields: [tenantId], references: [id])
  channel            Channel
  name               String
  body               String // placeholders {{nome}}, {{cidade}}, {{percentual}}, ...
  status             TemplateStatus @default(RASCUNHO)
  providerTemplateId String? // id do template aprovado no provedor (ex.: WhatsApp Business Template Name)
  rejectionReason    String?
  // WhatsApp (Meta): o template precisa ser criado e aprovado na Meta antes de qualquer envio fora
  // da janela de 24h (services/whatsappTemplates.ts). `body` usa {{nome}}...; na Meta vira {{1}}...
  language           String         @default("pt_BR")
  category           String? // MARKETING | UTILITY
  footer             String?
  quickReplies       Json? // string[] (até 3 botões de resposta rápida)
  version            Int            @default(1) // sobe a cada edição do texto depois de enviado à Meta
  metaName           String? // nome registrado na Meta (slug + _v{version})
  metaStatus         String? // APPROVED | PENDING | REJECTED | PAUSED | DISABLED ...
  qualityScore       String? // GREEN | YELLOW | RED | UNKNOWN
  submittedAt        DateTime?
  // Cabeçalho com imagem (único formato de cabeçalho que sabemos enviar). A imagem fica em TemplateMedia.
  headerFormat       String? // IMAGE
  headerHandle       String? // handle da Meta (upload resumível) usado como exemplo ao criar o template
  // Templates criados direto na Meta (ou em outro sistema) são IMPORTADOS na sincronização: origin=META.
  // O texto original da Meta tem {{1}},{{2}}...; `variableMap` diz qual variável nossa preenche cada posição
  // (null = ainda não mapeada) e `body` é o texto com os nomes das variáveis, para exibição.
  origin             String         @default("LOCAL") // LOCAL | META
  metaBody           String?
  variableMap        Json? // (string|null)[]
  buttons            Json? // botões que não são resposta rápida (link/telefone), só para exibir
  sendIssue          String? // motivo de não conseguirmos enviar (cabeçalho de vídeo, botão com variável...)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  campaigns Campaign[]
  media     TemplateMedia?

  @@unique([tenantId, channel, name])
}

/// Imagem do cabeçalho de um template do WhatsApp (até 3 MB: a Vercel limita o corpo da requisição).
model TemplateMedia {
  id         String          @id @default(uuid())
  tenantId   String
  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  templateId String          @unique
  template   MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  mime       String
  filename   String
  size       Int
  data       Bytes
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model Notification {
  id          String               @id @default(uuid())
  tenantId    String
  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  severity    NotificationSeverity @default(INFO)
  type        String // ex: IMPORT_FAILED, CAMPAIGN_BLOCKED, AUTOMATION_FIRED
  message     String
  relatedType String?
  relatedId   String?
  read        Boolean              @default(false)
  createdAt   DateTime             @default(now())

  @@index([tenantId, read, createdAt])
}

// Foto diária dos KPIs da base — é o que permite tendência real, variação vs. período anterior
// e comparação entre períodos no dashboard (sem isso só existe o "agora"). Uma linha por tenant
// por dia (`day` = data civil em Brasília); regravada (upsert) se o snapshot do dia for recalculado.
// O histórico começa no dia em que o job foi ligado — não dá para reconstruir o passado.
model DashboardSnapshot {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  day             DateTime
  totalClientes   Int
  ativos          Int
  inativos        Int
  bloqueados      Int
  semUso          Int
  limiteTotal     Decimal
  valorUtilizado  Decimal
  saldoDisponivel Decimal
  usaramNoDia     Int      @default(0) // clientes com dataUltimaUtilizacao naquele dia
  encerradosNoDia Int      @default(0) // clientes com encerradoEm naquele dia
  faixas          Json // { FAIXA_USO: contagem }
  healthScore     Int? // nota por uso real do dia (null = sem extrato em dia; ver healthData.ts)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, day])
  @@index([tenantId, day])
}

// Lojista do comércio credenciado (NomeFantasia na aba "Todas as Compras"). A categoria (supermercado,
// posto, farmácia...) não vem na planilha: é deduzida do nome (services/merchantCategories.ts) e fica
// editável (categorySource = MANUAL passa a ter prioridade sobre a dedução automática).
model Merchant {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  name           String
  nameKey        String // nome normalizado (minúsculas, sem acento) — chave de dedupe por tenant
  category       String   @default("OUTROS")
  categorySource String   @default("AUTO") // AUTO | MANUAL
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  purchases Purchase[]

  @@unique([tenantId, nameKey])
  @@index([tenantId, category])
}

// Transação do cartão (aba "Todas as Compras"). Só compras no comércio credenciado têm lojista;
// saque, Pix, assinatura e débito de fatura entram com merchantId nulo. externalId = idTransacaoCartao
// (reimportar a mesma planilha não duplica).
model Purchase {
  id             String    @id @default(uuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id])
  merchantId     String?
  merchant       Merchant? @relation(fields: [merchantId], references: [id])
  externalId     String
  occurredAt     DateTime
  tipo           String // Descricao da planilha (ex.: "Compra à Vista Cartão Top Convênio")
  merchantName   String?
  valorPrincipal Decimal
  valorParcela   Decimal?
  juros          Decimal?
  razaoSocial    String?
  importJobId    String?
  createdAt      DateTime  @default(now())

  @@unique([tenantId, externalId])
  @@index([tenantId, occurredAt])
  @@index([clientId, occurredAt])
  @@index([merchantId, occurredAt])
}

// ---------------------------------------------------------------------------------------------
// Inbox do WhatsApp (Cloud API da Meta) — Fase 1: receber e listar conversas.
// ---------------------------------------------------------------------------------------------

enum WaDirection {
  ENTRADA // do cliente para nós
  SAIDA // de nós para o cliente
}

enum ConversationStatus {
  ABERTA
  ARQUIVADA
}

/// Número de WhatsApp Business ligado a um tenant. O webhook da Meta identifica o número por
/// `phoneNumberId`, que por isso é único no banco inteiro. O token de acesso NÃO fica aqui.
model WhatsAppAccount {
  id               String    @id @default(uuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  // META = Cloud API oficial (tudo que existia). ZAPI = Z-API (não oficial, QR code): `phoneNumberId` guarda
  // "zapi:<instanceId>", `credentials` guarda { token, clientToken } cifrados e `verifyToken` é o segredo da URL do webhook.
  provider         String    @default("META")
  phoneNumberId    String    @unique
  wabaId           String?
  appId            String? // ID do app da Meta: necessário para enviar a imagem de exemplo de templates com cabeçalho
  displayName      String?
  displayPhone     String?
  active           Boolean   @default(true)
  // Credenciais da Meta ficam CIFRADAS aqui ({ accessToken, appSecret }, services/crypto.ts), nunca em
  // texto puro nem de volta para a tela. As "dicas" guardam só os 4 últimos caracteres para exibição.
  credentials      Json?
  accessTokenHint  String?
  appSecretHint    String?
  // Token que o sistema gera e a Meta devolve no desafio (GET) ao cadastrar o webhook.
  verifyToken      String?   @unique
  lastCheckAt      DateTime?
  lastCheckOk      Boolean?
  lastCheckMessage String?
  // Resposta automática a quem escreve neste número (canal só de avisos: manda o cliente ao suporte).
  // Texto nulo = usa o padrão de services/whatsappAutoReply.ts.
  autoReplyEnabled Boolean   @default(true)
  autoReplyText    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  conversations Conversation[]

  @@index([tenantId])
}

/// Uma conversa por (número nosso, número do cliente). `clientId` é nulo quando o telefone não
/// bate com nenhum cliente da base. A janela de 24 horas conta a partir de `lastInboundAt`.
model Conversation {
  id             String             @id @default(uuid())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  accountId      String
  account        WhatsAppAccount    @relation(fields: [accountId], references: [id])
  clientId       String?
  client         Client?            @relation(fields: [clientId], references: [id])
  waId           String // telefone do cliente como a Meta informa (só dígitos, com DDI)
  contactName    String? // nome do perfil do WhatsApp
  status         ConversationStatus @default(ABERTA)
  lastMessageAt  DateTime
  lastInboundAt  DateTime?
  lastPreview    String?
  unreadCount    Int                @default(0)
  assignedUserId String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  messages WaMessage[]

  @@unique([accountId, waId])
  @@index([tenantId, lastMessageAt])
  @@index([tenantId, clientId])
}

model WaMessage {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  direction      WaDirection
  wamid          String? // id da mensagem na Meta (idempotência do webhook)
  type           String // text | image | audio | video | document | sticker | location | ...
  body           String? // texto, legenda ou descrição
  mediaId        String? // id da mídia na Meta (o download é a Fase 2)
  mediaMime      String?
  mediaFilename  String?
  status         String? // só saída: sent | delivered | read | failed
  sentByUserId   String? // quem respondeu (só saída)
  automatic      Boolean      @default(false) // resposta automática do sistema (sem usuário)
  errorText      String?
  timestamp      DateTime // horário da mensagem segundo a Meta
  createdAt      DateTime     @default(now())

  @@unique([tenantId, wamid])
  @@index([conversationId, timestamp])
}

/// Cópia local da mídia recebida (a Meta só guarda por tempo limitado). Limitada a 4 MB porque a
/// Vercel não devolve respostas maiores que ~4,5 MB; arquivos maiores não são guardados.
model WaMediaBlob {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  messageId String   @unique
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([tenantId])
}

/// LGPD (02-03, 03-01): supressão por titular que sobrevive à anonimização e à reimportação. Guarda só hashes
/// (telefone canônico e documento, HMAC com Tenant.cpfSalt), nunca o dado em claro. Consultada no envio e na
/// importação.
model SupressaoTitular {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  phoneHash String?
  docHash   String?
  motivo    String // OPT_OUT | ELIMINACAO | BLOQUEIO
  canal     String? // WHATSAPP | SMS | MANUAL | ...
  origem    String // de onde veio: inbox, sms, pedido do titular, operador...
  pedidoId  String?
  createdAt DateTime @default(now())

  @@index([tenantId, phoneHash])
  @@index([tenantId, docHash])
}

/// LGPD (03-05): pedido de titular (art. 18) com prazo de resposta (art. 19: até 15 dias).
model PedidoTitular {
  id             String    @id @default(uuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  clientId       String?
  telefoneMasked String?
  tipo           String // CONFIRMACAO | ACESSO | CORRECAO | ELIMINACAO | BLOQUEIO | PORTABILIDADE | COMPARTILHAMENTO | OPOSICAO | REVOGACAO
  canal          String // WHATSAPP | SMS | EMAIL | TELEFONE | OUTRO
  status         String    @default("ABERTO") // ABERTO | ATENDIDO | NEGADO
  descricao      String?
  recebidoEm     DateTime  @default(now())
  prazoEm        DateTime
  respondidoEm   DateTime?
  resposta       String?
  userId         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, clientId])
}

/// Ciclo de cobrança por cidade: dia em que o limite renova (abertura) e dia de fechamento (o anterior).
model CicloCidade {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  cidadeKey     String // chave de comparação (cidades.ts: minúscula, sem espaços nas pontas)
  cidade        String // nome para exibição
  diaAbertura   Int
  diaFechamento Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, cidadeKey])
}

/// Etiqueta do cliente (era `Client.tags String[]` no Postgres; o SQLite não tem lista escalar).
/// O filtro de segmento `tags` casa quem tem QUALQUER uma das etiquetas (`some` + `in`).
model ClientTag {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag      String

  @@unique([clientId, tag])
  @@index([tenantId, tag])
}

// CRM TopConta — Prisma schema
// Modela as entidades principais descritas no PRD:
// Tenant, User, Client, ImportJob, Movement, SegmentDefinition,
// Campaign, MessageEvent, AutomationRule, AuditLog

generator client {
  provider      = "prisma-client-js"
  // "native" para dev local; "rhel-openssl-3.0.x" é o runtime das Lambdas da Vercel/AWS.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Em serverless (Vercel), aponte para o connection pooler do Supabase (porta 6543,
  // "Transaction" mode) — evita esgotar as conexões diretas do Postgres a cada invocação de
  // função. Em servidor de longa duração (dev local, Railway/Render), a conexão direta (5432)
  // funciona igualmente bem.
  url       = env("DATABASE_URL")
  // Conexão direta (porta 5432), usada apenas por `prisma migrate`/`prisma db push` — nunca em
  // runtime. Pode apontar para o mesmo valor de DATABASE_URL quando não se usa pooler.
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  OPERATOR
  ANALYST
  VIEWER
}

enum ClientStatus {
  ATIVO
  INATIVO
  BLOQUEADO
}

enum UsageFaixa {
  NAO_UTILIZOU
  BAIXO_USO
  USO_INICIAL
  USO_INTERMEDIARIO
  USO_ALTO
  QUASE_COMPLETO
  LIMITE_COMPLETO
  INDEFINIDO // limite_total inválido/zero
}

enum Channel {
  WHATSAPP
  SMS
}

enum CampaignStatus {
  RASCUNHO
  AGENDADA
  EM_EXECUCAO
  PAUSADA
  CONCLUIDA
  CANCELADA
}

enum MessageStatus {
  FILA
  ENVIADO
  ENTREGUE
  LIDO
  RESPONDIDO
  FALHA
  BLOQUEADO
}

enum ImportStatus {
  PENDENTE
  EM_EXECUCAO
  CONCLUIDO
  CONCLUIDO_COM_ERROS
  FALHOU
}

enum TemplateStatus {
  RASCUNHO
  PENDENTE_APROVACAO
  APROVADO
  REJEITADO
}

enum NotificationSeverity {
  INFO
  AVISO
  ERRO
}

model Tenant {
  id                 String   @id @default(uuid())
  name               String
  cpfSalt            String   @default(uuid()) // salt por tenant para hash de CPF
  retentionDays       Int      @default(1095) // 3 anos default (LGPD)
  maxMsgsPerMinute    Int      @default(600) // rate limit global do tenant, aplicado no dispatch de campanhas
  createdAt          DateTime @default(now())

  users              User[]
  clients            Client[]
  importJobs         ImportJob[]
  segments           SegmentDefinition[]
  campaigns          Campaign[]
  automationRules    AutomationRule[]
  auditLogs          AuditLog[]
  sheetConnections   SheetConnection[]
  channelConfigs     ChannelConfig[]
  messageTemplates   MessageTemplate[]
  notifications      Notification[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(VIEWER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Segurança de login (rate limiting anti brute-force) — armazenado no banco (não em memória
  // do processo) para funcionar de forma consistente entre invocações serverless distintas.
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime? // conta bloqueada para login até este instante

  // Forçado após reset de senha por um Admin (sem fluxo de e-mail) — o próprio usuário troca no
  // primeiro login seguinte.
  mustChangePassword Boolean   @default(false)

  // 2FA (TOTP, tipo Google Authenticator) — segredo cifrado em repouso (envelope encryption,
  // mesma abordagem de ChannelConfig.credentials, ver services/crypto.ts). O segredo só é
  // considerado válido para login quando twoFactorEnabled = true (setup não confirmado ainda
  // não afeta o login).
  twoFactorSecret    String?
  twoFactorEnabled   Boolean   @default(false)

  auditLogs    AuditLog[]
}

model Client {
  id                     String       @id @default(uuid())
  tenantId               String
  tenant                 Tenant       @relation(fields: [tenantId], references: [id])

  externalId             String? // id_cliente da planilha de origem
  nome                   String
  telefone               String // normalizado E.164
  email                  String?
  // cpfHash/cpfMasked guardam CPF (pessoa física) OU CNPJ (pessoa jurídica) — a coluna de
  // origem real ("CpfCnpjCliente") traz os dois; documentoTipo diferencia qual é qual.
  // Ver services/masking.ts (isValidDocument/hashDocument/maskDocument).
  cpfHash                String
  cpfMasked              String
  documentoTipo          String? // "CPF" | "CNPJ"
  cidade                 String?

  dataCadastro           DateTime?
  dataAberturaConta      DateTime?
  limiteTotal            Decimal      @default(0) @db.Decimal(14, 2)
  valorUtilizado         Decimal      @default(0) @db.Decimal(14, 2)
  saldoDisponivel        Decimal      @default(0) @db.Decimal(14, 2)
  valorAntecipado        Decimal      @default(0) @db.Decimal(14, 2)
  dataUltimaUtilizacao   DateTime?

  percentualUtilizado    Decimal      @default(0) @db.Decimal(6, 2)
  faixaUso               UsageFaixa   @default(NAO_UTILIZOU)

  statusConta            ClientStatus @default(ATIVO)
  origemCliente          String?
  autorizacaoComunicacao Boolean      @default(false)
  optOutAt               DateTime?

  // Cartão/conta vinculado a convênio (folha de pagamento): nome e cidade da empresa
  // conveniada, e vínculo empregatício do titular — usados para segmentar campanhas por
  // convênio (ex.: "só servidores efetivos da Prefeitura de Lagarto"). Preenchidos apenas
  // pelo formato de importação que os traz (nem toda planilha real tem essas colunas).
  empresaConveniada       String?
  cidadeEmpresaConveniada String?
  vinculoEmpregaticio     String?
  statusValidacaoCadastro String? // eixo de validação de cadastro, separado do statusConta (ex.: "APROVADO")

  // Encerramento de conta — distinto de statusConta=BLOQUEADO (que é uma trava ativa); conta
  // encerrada é tratada como INATIVA na importação, mas mantém o motivo para consulta.
  encerradoEm             DateTime?
  motivoEncerramento      String?
  obsEncerramento         String?

  // Campos da aba "SaldoCartao" (fonte real mais completa, confirmada com o cliente) — nem
  // toda planilha real traz isso, por isso tudo opcional.
  razaoSocial             String? // razão social da promotora/associação que administra o cartão
  lotacao                 String? // departamento/unidade de trabalho do titular (servidor público)
  dataValidadeCartao      DateTime?
  dataNascimento          DateTime?
  sexo                    String?
  remuneracaoBruta        Decimal?     @db.Decimal(14, 2)
  remuneracaoLiquida      Decimal?     @db.Decimal(14, 2)
  bonus                   Decimal?     @db.Decimal(14, 2)
  saldoLiquidoSaque       Decimal?     @db.Decimal(14, 2)

  tags                   String[]     @default([])

  createdAt              DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  lastImportJobId        String?
  anonymizedAt           DateTime? // preenchido pelo job de retenção/right-to-be-forgotten (LGPD)

  movements              Movement[]
  messageEvents          MessageEvent[]

  @@unique([tenantId, cpfHash])
  @@index([tenantId, telefone])
  @@index([tenantId, cidade])
  @@index([tenantId, faixaUso])
  @@index([tenantId, statusConta])
}

model ImportJob {
  id           String       @id @default(uuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  source       String       @default("google_sheets") // google_sheets | csv
  sheetId      String?
  status       ImportStatus @default(PENDENTE)
  totalRows    Int          @default(0)
  addedCount   Int          @default(0)
  updatedCount Int          @default(0)
  errorCount   Int          @default(0)
  errors       Json?        // lista de {row, motivo}
  startedAt    DateTime     @default(now())
  finishedAt   DateTime?
  triggeredBy  String?      // userId ou "scheduler"
}

model Movement {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  tipo      String   // ex: utilizacao, pagamento, antecipacao
  valor     Decimal  @db.Decimal(14, 2)
  data      DateTime
  createdAt DateTime @default(now())

  @@index([clientId, data])
}

model SegmentDefinition {
  id               String    @id @default(uuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  name             String
  // Estrutura de grupos combináveis (AND/OR): { operator: 'AND'|'OR', conditions: SegmentFilters,
  // groups?: SegmentGroup[] } — ver src/services/segments.ts. Mantido em Json para não exigir
  // migração a cada novo campo de filtro suportado.
  filters          Json
  operator         String    @default("AND") // AND | OR entre grupos de filtro (legado/top-level)
  lastCount        Int?
  dynamic          Boolean   @default(true) // segmento dinâmico: recontagem periódica via scheduler
  refreshCron      String    @default("0 * * * *") // a cada hora, por padrão
  lastRefreshedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  campaigns Campaign[]
}

model Campaign {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  name            String
  objective       String?
  channel         Channel
  segmentId       String?
  segment         SegmentDefinition? @relation(fields: [segmentId], references: [id])
  adHocFilters    Json?          // filtros aplicados diretamente no wizard, se não usar segmento salvo

  templateId      String?
  template        MessageTemplate? @relation(fields: [templateId], references: [id])
  messageTemplate String         // corpo com placeholders {{nome}}, {{cidade}}, {{percentual}}... (variante A, ou texto livre se sem templateId)
  status          CampaignStatus @default(RASCUNHO)

  // A/B testing básico: quando variantSplitPercent está definido, uma fração do público
  // recebe messageTemplateB no lugar de messageTemplate (variante A).
  messageTemplateB     String?
  variantSplitPercent  Int?      // 0-100, % do público que recebe a variante B

  isSandbox       Boolean        @default(false) // campanhas de teste/QA não contam para relatórios agregados

  scheduledAt     DateTime?
  throttlePerMin  Int            @default(60)
  dedupeWindowHrs Int            @default(72) // janela mínima entre envios da mesma msg ao mesmo cliente
  attributionDays Int            @default(7)
  costPerMessage  Decimal        @default(0) @db.Decimal(10, 4)

  audienceCount   Int?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  messageEvents   MessageEvent[]
}

model MessageEvent {
  id           String        @id @default(uuid())
  campaignId   String
  campaign     Campaign      @relation(fields: [campaignId], references: [id])
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id])
  channel      Channel
  status       MessageStatus @default(FILA)
  variant      String        @default("A") // "A" ou "B" — usado quando a campanha tem A/B testing ativo
  provider     String?       // provedor efetivamente usado (para failover multi-provider de SMS)
  providerMsgId String?
  cost         Decimal       @default(0) @db.Decimal(10, 4)
  error        String?
  queuedAt     DateTime      @default(now())
  sentAt       DateTime?
  deliveredAt  DateTime?
  respondedAt  DateTime?
  convertedAt  DateTime?     // primeira movimentação dentro da janela de atribuição
  convertedValue Decimal?    @db.Decimal(14, 2) // valor da movimentação que gerou a conversão (ROI)

  @@index([campaignId, status])
  @@index([clientId])
}

model AutomationRule {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  name       String
  trigger    String   // NOVO_CLIENTE_SEM_USO | INATIVO_30_DIAS | LIMITE_RENOVADO | ESTIMULO_FAIXA | OPT_OUT_TELEFONE_INVALIDO
  condition  Json?
  action     Json     // { type: 'campaign' | 'notification' | 'block', ... }
  enabled    Boolean  @default(false)
  lastRunAt  DateTime? // usado para não reavaliar o mesmo evento repetidamente (janela desde a última execução)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  target    String?
  targetId  String?
  details   Json?
  createdAt DateTime @default(now())
  // Hash-chain (tamper-evidence, achado #11 do docs/security-audit/findings.md): prevHash é o
  // `hash` da entrada anterior na cadeia GLOBAL (todas as tenants, ordenada por createdAt — não
  // por tenant, para manter uma única cadeia verificável); hash é o SHA-256 desta própria linha
  // + prevHash. Ambos nullable porque entradas gravadas antes desta mudança não entram
  // retroativamente na cadeia (limitação aceita, ver services/auditIntegrity.ts).
  prevHash  String?
  hash      String?

  @@index([tenantId, createdAt])
}

model SheetConnection {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  sheetId       String
  sheetRange    String   @default("A1:Z")
  authType      String   @default("service_account") // service_account | oauth2
  columnMapping Json     // { "id_cliente": "A", "nome": "B", ... }
  cronSchedule  String   @default("0 6 * * 1,4") // 2x/semana por padrão
  lastSyncAt    DateTime?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model ChannelConfig {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  channel    Channel
  provider   String   // whatsapp_cloud_api | twilio | zenvia ...
  // Envelope encryption: { iv, authTag, ciphertext } em base64, cifrado com AES-256-GCM usando
  // a chave mestra da aplicação (env CREDENTIALS_ENCRYPTION_KEY — simula uma KMS externa).
  // Nunca contém as credenciais em texto plano. Ver src/services/crypto.ts.
  credentials Json
  // Ordem de fallback entre múltiplos provedores do mesmo canal (menor = tentado primeiro).
  // Usado principalmente para failover multi-provider de SMS.
  priority   Int      @default(0)
  webhookSecret String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([tenantId, channel, provider])
  @@index([tenantId, channel, priority])
}

model MessageTemplate {
  id                String         @id @default(uuid())
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id])
  channel           Channel
  name              String
  body              String         // placeholders {{nome}}, {{cidade}}, {{percentual}}, ...
  status            TemplateStatus @default(RASCUNHO)
  providerTemplateId String?       // id do template aprovado no provedor (ex.: WhatsApp Business Template Name)
  rejectionReason   String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  campaigns Campaign[]

  @@unique([tenantId, channel, name])
}

model Notification {
  id          String                @id @default(uuid())
  tenantId    String
  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  severity    NotificationSeverity  @default(INFO)
  type        String                // ex: IMPORT_FAILED, CAMPAIGN_BLOCKED, AUTOMATION_FIRED
  message     String
  relatedType String?
  relatedId   String?
  read        Boolean               @default(false)
  createdAt   DateTime              @default(now())

  @@index([tenantId, read, createdAt])
}

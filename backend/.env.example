# Banco de dados — RLS real (achado #1/#6b, docs/security-audit/findings.md): dois roles
# Postgres distintos, dois connection strings.
# DATABASE_URL: role `app_runtime` (RLS aplicado de verdade — sem BYPASSRLS), usado por toda
#   query de request normal (config/db.ts). Local (docker-compose, depois da migration
#   add_rls_policies): postgresql://app_runtime:<senha>@localhost:5432/crmtopconta?schema=public
# DATABASE_URL_ADMIN: role privilegiado (o `postgres`/bypass de sempre), usado SÓ pelos jobs
#   cross-tenant do scheduler (config/tenantGuard.ts, withCrossTenantAccess) e por
#   prisma/seed.ts (precisa criar o próprio Tenant, antes de qualquer tenantId existir).
#   Local: postgresql://crmtopconta:crmtopconta@localhost:5432/crmtopconta?schema=public
# Supabase (produção/serverless): ambas devem usar a connection string do "Connection Pooler"
#   (Transaction mode, porta 6543) em Project Settings → Database → Connection string, trocando
#   só o usuário/senha. DIRECT_URL usa a conexão direta (porta 5432, sempre o role privilegiado)
#   e só é usada por `prisma migrate`/`prisma db push`, nunca em runtime.
DATABASE_URL="postgresql://app_runtime:troque-esta-senha@localhost:5432/crmtopconta?schema=public"
DATABASE_URL_ADMIN="postgresql://crmtopconta:crmtopconta@localhost:5432/crmtopconta?schema=public"
DIRECT_URL="postgresql://crmtopconta:crmtopconta@localhost:5432/crmtopconta?schema=public"

# Autenticação
JWT_SECRET="troque-este-valor-em-producao"

# CORS — lista separada por vírgula das origens do frontend autorizadas a chamar esta API.
# Em produção, defina para a(s) URL(s) do frontend na Vercel (ex.:
# "https://crmtopconta-frontend.vercel.app"). Sem esta variável, a API só aceita requisições de
# http://localhost:5173 (dev local) — nunca abre para qualquer origem por padrão.
ALLOWED_ORIGINS="http://localhost:5173"

# Envelope encryption das credenciais de canal (ChannelConfig) — gere com:
# openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# Segredo compartilhado que protege os endpoints /api/cron/* (usados pelos Vercel Cron Jobs em
# produção serverless — ver vercel.json). Gere com: openssl rand -base64 32
CRON_SECRET=

# Google Sheets — Service Account (JSON completo em uma linha)
GOOGLE_SERVICE_ACCOUNT_JSON=

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App Secret do app Meta (Meta App Dashboard → Settings → Basic) — distinto do
# WHATSAPP_WEBHOOK_VERIFY_TOKEN acima (que só serve para o challenge do GET). Usado para
# verificar a assinatura X-Hub-Signature-256 nas chamadas POST do webhook, comprovando que a
# requisição veio mesmo da Meta. Enquanto não configurado, o webhook aceita POSTs sem verificação
# de assinatura (com um aviso no log a cada requisição) — configure assim que possível.
WHATSAPP_APP_SECRET=

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

PORT=4000
# "false" desliga o scheduler de sincronização automática (útil em ambiente de teste, e
# irrelevante em produção serverless — lá os jobs rodam via Vercel Cron Jobs, não pelo
# node-cron em processo).
ENABLE_SCHEDULER=true

# Banco de dados
DATABASE_URL="postgresql://crmtopconta:crmtopconta@localhost:5432/crmtopconta?schema=public"

# Autenticação
JWT_SECRET="troque-este-valor-em-producao"

# Google Sheets — Service Account (JSON completo em uma linha)
GOOGLE_SERVICE_ACCOUNT_JSON=

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

PORT=4000
# "false" desliga o scheduler de sincronização automática (útil em ambiente de teste)
ENABLE_SCHEDULER=true

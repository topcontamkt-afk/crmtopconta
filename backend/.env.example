# Variáveis do backend. Na Cloudflare (Worker) elas vêm de dois lugares, por ambiente:
#  - `vars` do wrangler.jsonc: o que não é segredo (APP_ENV, ALLOWED_ORIGINS, PUBLIC_BACKEND_URL, MESSAGING_MODE);
#  - segredos: `.dev.vars` no `wrangler dev` (fora do git, mesmo formato deste arquivo) e
#    `npx wrangler secret put NOME --env hml` na homologação.
# Este arquivo (copiado para `.env`) só vale para o servidor Node local (`npm run dev`) e para os scripts.
# O banco é o D1 (binding DB do wrangler.jsonc): não há DATABASE_URL.

# Autenticação (obrigatória). Gere com: openssl rand -base64 48
JWT_SECRET="troque-este-valor"

# Envelope encryption das credenciais de canal e do WhatsApp (obrigatória). Gere com: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# CORS — origens autorizadas, separadas por vírgula. No Worker a SPA é servida pela mesma origem da API.
ALLOWED_ORIGINS="http://localhost:5173"

# Endereço público do backend, sem barra no fim. Monta as URLs que vão para fora: webhooks da Meta/Z-API/SMS,
# link rastreado dos templates e a ligação do Twilio (que também confere a assinatura com ele). Sem ela essas
# telas avisam e não geram URL. Os provedores precisam chamar exatamente este domínio.
PUBLIC_BACKEND_URL="http://localhost:4000"
# Domínio dos links rastreados, se diferente do acima. Ele entra no template aprovado pela Meta: trocar exige
# nova versão do template.
LINK_BASE_URL=
# https para onde vai um link rastreado inválido (opcional; sem ela, 404).
LINK_FALLBACK_URL=

# "mock": canal sem credencial do tenant SIMULA o envio (local e homologação). Qualquer outro valor (ou vazio):
# sem canal do tenant não há envio.
MESSAGING_MODE=mock

# Segredo dos endpoints /api/cron/* (Bearer). Gere com: openssl rand -base64 32
CRON_SECRET=

# Google Sheets — Service Account (JSON completo em uma linha)
GOOGLE_SERVICE_ACCOUNT_JSON=

# WhatsApp Cloud API: as credenciais ficam por tenant na tela Integrações (cifradas). Estas são só reserva
# (ver PLATFORM_DEFAULT_TENANT_ID abaixo).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# LGPD 06-01: as credenciais de canal acima (WHATSAPP_ACCESS_TOKEN, TWILIO_*) só valem como reserva
# para o tenant indicado em PLATFORM_DEFAULT_TENANT_ID, ou para todos com
# ALLOW_GLOBAL_CHANNEL_CREDENTIALS=true (só em desenvolvimento). Sem isso, tenant sem canal próprio
# não envia (com MESSAGING_MODE=mock, simula): cada controlador usa a própria conta.
PLATFORM_DEFAULT_TENANT_ID=
ALLOW_GLOBAL_CHANNEL_CREDENTIALS=

# Servidor Node local
PORT=4000
# "false" desliga o node-cron do servidor Node local. No Worker os jobs rodam pelos Cron Triggers.
ENABLE_SCHEDULER=true

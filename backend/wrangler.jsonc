// Worker do CRM na Cloudflare (migração do zero, ver docs/infra/cloudflare-fase0.md).
// Um só Worker serve a SPA (frontend/dist) e a API. O nível de cima é o ambiente LOCAL
// (`wrangler dev`, D1/R2 simulados pelo Miniflare); `env.hml` é a homologação no workers.dev.
// Bindings não são herdados entre ambientes: cada `env.*` repete os seus.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crmtopconta-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // a API e o link rastreado nunca caem no index.html da SPA
    "run_worker_first": ["/api/*", "/r/*"]
  },
  // Segredos (JWT_SECRET, CREDENTIALS_ENCRYPTION_KEY…): `.dev.vars` no local (fora do git) e
  // `wrangler secret put --env hml` na homologação. Mesma origem da SPA: o CORS só libera ela.
  "vars": {
    "APP_ENV": "local",
    "ALLOWED_ORIGINS": "http://localhost:8787,http://localhost:5173",
    "PUBLIC_BACKEND_URL": "http://localhost:8787",
    "MESSAGING_MODE": "mock"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "crmtopconta-local", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "crmtopconta-local-media" }],
  // Os 7 jobs diários em 3 triggers (o plano grátis dá 5 para a conta toda): ver src/services/cronTriggers.ts.
  // No local: `wrangler dev --test-scheduled` e GET /__scheduled?cron=0+3+*+*+*
  "triggers": { "crons": ["0 3 * * *", "0 6 * * *", "0 9-11 * * *"] },
  "env": {
    "hml": {
      "name": "crmtopconta-hml",
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "../frontend/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/r/*"]
      },
      "vars": {
        "APP_ENV": "hml",
        "ALLOWED_ORIGINS": "https://crmtopconta-hml.topcontamkt.workers.dev",
        "PUBLIC_BACKEND_URL": "https://crmtopconta-hml.topcontamkt.workers.dev",
        // homologação não envia de verdade sem canal do tenant: o envio é simulado
        "MESSAGING_MODE": "mock"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "crmtopconta-hml", "database_id": "9945cc44-3f12-404f-8505-96d68bd21a6e" }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "crmtopconta-hml-media" }],
      "triggers": { "crons": ["0 3 * * *", "0 6 * * *", "0 9-11 * * *"] }
    }
  }
}
